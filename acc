def open_db(d: dict):
    status = str(v(d, "status", "")).upper()
    opts: list[tuple[str, object]] = [
        ("View details", lambda: print_db_detail(d)),
        ("Show connection credentials", lambda: db_credentials(d)),
        ("View logs", lambda: db_logs(d)),
    ]
    if status == "STOPPED":
        opts.append(("Start", db_power(d, "Start", "startDatabase")))
    if status == "RUNNING":
        opts.append(("Stop", db_power(d, "Stop", "stopDatabase")))
        opts.append(("Restart", db_power(d, "Restart", "restartDatabase")))
    opts.append(("Delete", lambda: db_delete(d)))
