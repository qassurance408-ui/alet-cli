                                      "customDomain": a.get("customDomain"),
                                      "pathPrefix": prefix})
    except AletError as e:
        error_screen("Could not check that path", e)
        return
    available = check.get("available", True) if isinstance(check, dict) else True
    if not available:
        clear_screen()
        fail(f"'{prefix}' is already taken on this domain.")
        reason = check.get("reason") or check.get("message") if isinstance(check, dict) else None
        if reason:
            print(f"\n  {GREY}{reason}{RESET}")
        pause()
        return
    if not confirm(f"Serve '{v(a, 'appName')}' at {prefix}?"):
        return
    act("Setting the route", f"{v(a, 'appName')} now answers at {prefix}.",
        "setAppRoute", {"projectId": a["projectId"], "appId": a["id"], "pathPrefix": prefix})


