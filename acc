def domain_label(d: dict) -> str:
    return (f"{trunc(v(d, 'name', v(d, 'domainName')), 30):<30} "
            f"{status_cell(v(d, 'status', '?'))} {GREY}expires {fmt_dt(d.get('expiresAt'), 10)}{RESET}")


def _domain_name(d: dict) -> str:
    return v(d, "name", v(d, "domainName", "domain"))


def dns_records(d: dict):
    while True:
        records = load(f"DNS records for {_domain_name(d)}", "getDnsRecords", {"domainId": d["id"]})
        if records is None:
            return
        rows = [f"{v(r, 'type', ''):<7} {trunc(v(r, 'host', '@'), 24):<24} "
                f"{GREY}{trunc(v(r, 'value', ''), 34):<34} TTL {v(r, 'ttl', '')}{RESET}"
                for r in records]
        choice = menu(f"{_domain_name(d)} — DNS records",
                      rows + ["＋  Add a record", "← Back"],
                      f"{len(records)} record(s)")
        if choice is None or choice == len(rows) + 1:
            return
        if choice == len(rows):
            dns_edit(d, None)
        else:
            r = records[choice]
            sub = menu(f"{v(r, 'type')} {v(r, 'host')}", ["Edit", "Delete", "← Back"],
                       trunc(v(r, "value", ""), 60))
            if sub == 0:
                dns_edit(d, r)
            elif sub == 1:
                if danger_confirm(f"Delete the {v(r, 'type')} record for {v(r, 'host')}?",
                                  "Anything resolving through this record stops working."):
                    act("Deleting the record", "Record deleted.",
                        "deleteDnsRecord", {"domainId": d["id"], "recordId": r["id"]})


def dns_edit(d: dict, record: dict | None):
    editing = record is not None
    header(_domain_name(d), "Edit a DNS record" if editing else "Add a DNS record")
    rtype = pick_from(["A", "AAAA", "CNAME", "TXT", "MX", "NS", "SRV", "CAA"],
                      lambda t: t, "Record type",
                      f"Currently {v(record, 'type')}" if editing else "")
    if not rtype:
        return
    header(_domain_name(d), f"{rtype} record")
    print(f"  {GREY}Use @ for the domain itself, or a name like 'www'.{RESET}\n")
    host = ask("Host", v(record, "host", "@") if editing else "@")
    if not host:
        return
    value = ask("Value", v(record, "value") if editing else None)
    if not value:
        return
    ttl = ask_int("TTL (seconds)", record.get("ttl") if editing else 3600)
    priority = ask_int("Priority", record.get("priority") if editing else None,
                       required=False) if rtype in ("MX", "SRV") else None

    args = {"domainId": d["id"], "type": rtype, "host": host, "value": value,
            "ttl": ttl, "priority": priority}
    if editing:
        if not confirm(f"Update the {rtype} record for {host}?"):
            return
        args["recordId"] = record["id"]
        act("Updating the record", "Record updated.", "updateDnsRecord", args)
    else:
        if not confirm(f"Add a {rtype} record for {host}?"):
            return
        act("Adding the record", "Record added.", "addDnsRecord", args)


