# ── VPN Access ────────────────────────────────────────────────────────────────
def vpn_devices(state: dict):
    while True:
        devices = load("VPN devices", "listVpnDevices")
        if devices is None:
            return
        rows = [f"{trunc(v(d, 'name'), 22):<22} {status_cell(v(d, 'status', '?'))} "
                f"{GREY}{v(d, 'address'):<18} last seen {fmt_dt(d.get('lastHandshakeAt'), 16) if d.get('lastHandshakeAt') else 'never'}{RESET}"
                for d in devices]
        choice = menu("VPN devices", rows + ["＋  Add a device", "← Back"],
                      f"{len(devices)} device(s) on {v(state, 'vpnSubnet', 'the tunnel')}")
        if choice is None or choice == len(rows) + 1:
            return
        if choice == len(rows):
            vpn_add_device()
        else:
            d = devices[choice]
            if danger_confirm(f"Remove '{v(d, 'name')}'?",
                              "The device loses access to the private network immediately."):
                act("Removing the device", f"{v(d, 'name')} removed.",
                    "removeVpnDevice", {"peerId": d["id"]})


def vpn_add_device():
    header("Add a VPN device", "You get a ready-to-use WireGuard configuration")
    name = ask("Device name (e.g. laptop)")
    if not name:
        return
    print(f"\n  {GREY}Leave the key blank and AletCloud generates a keypair for you.{RESET}\n")
    pubkey = ask("WireGuard public key", required=False)
    if pubkey is None:
        return
    loading("Adding the device")
    try:
        data = call("addVpnDevice", {"name": name, "clientPublicKey": pubkey or None})
    except AletError as e:
        error_screen("Could not add the device", e)
        return
    config = None
    if isinstance(data, dict):
        config = data.get("config") or data.get("wireguardConfig") or data.get("clientConfig")
    if config:
        header(f"VPN — {name}", "Save this as wg0.conf on the device")
        print(f"  {YELLOW}Contains a private key. It is shown once.{RESET}\n")
        for line in str(config).splitlines():
            print(f"  {LIME}{line}{RESET}")
        pause()
    else:
        clear_screen()
        ok(f"{name} added to the VPN.")
        if isinstance(data, dict):
            print()
            for k, val in data.items():
                if not isinstance(val, (dict, list)):
                    kv(k, val, 20)
        pause()


def screen_vpn():
    while True:
        state = load("VPN access", "getVpnAccess")
        if state is None:
            return
        if not isinstance(state, dict):
            state = {}
        enabled = bool(state.get("enabled"))
        status = v(state, "status", "DISABLED")
        peers = state.get("peers") or []

        panel = [f"  {GREY}{'Status':<18}{RESET} {paint(status)}"]
        if enabled:
            panel += [
                f"  {GREY}{'Endpoint':<18}{RESET} {LIME}{v(state, 'endpoint')}{RESET}",
                f"  {GREY}{'Private range':<18}{RESET} {v(state, 'vpnSubnet')}",
                f"  {GREY}{'Devices':<18}{RESET} {len(peers)}",
            ]
        else:
            panel.append(f"  {GREY}VPN Access is off. Turning it on takes about 30 seconds.{RESET}")

        opts = (["Devices", "Turn VPN off"] if enabled else ["Turn VPN on"]) + ["Refresh", "← Back"]
        choice = menu("VPN Access", opts, "Reach your private resources from anywhere", panel)
        if choice is None or opts[choice] == "← Back":
            return
        picked = opts[choice]
        if picked == "Devices":
            vpn_devices(state)
        elif picked == "Turn VPN on":
            if confirm("Enable VPN Access?"):
                act("Setting up the tunnel",
                    "VPN Access is provisioning — give it about 30 seconds, then refresh.",
                    "enableVpnAccess")
        elif picked == "Turn VPN off":
            if danger_confirm("Disable VPN Access?",
                              f"All {len(peers)} device(s) are removed and the tunnel is torn down."):
                act("Tearing down the tunnel", "VPN Access is being disabled.", "disableVpnAccess")


