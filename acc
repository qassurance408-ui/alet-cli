def _show_secret(title: str, rows: list[tuple[str, str]]):
    header(title, "Save these now")
    print(f"  {YELLOW}The secret is shown once and cannot be retrieved again.{RESET}\n")
    for label, value in rows:
        kv(label, f"{LIME}{value}{RESET}" if value else "—")
    pause()


def bucket_keys(b: dict):
    while True:
        keys = load(f"access keys for {v(b, 'name')}", "listBucketAccessKeys", {"bucketId": b["id"]})
        if keys is None:
            return
        rows = [f"{trunc(v(k, 'label', 'unlabelled'), 22):<22} {GREY}{v(k, 'accessKeyId')}   "
                f"{'active' if k.get('active') else 'revoked'}{RESET}" for k in keys]
        choice = menu(f"{v(b, 'name')} — access keys",
                      rows + ["＋  Create a key for this bucket", "← Back"],
                      "Each key reaches this bucket only")
        if choice is None or choice == len(rows) + 1:
            return
        if choice == len(rows):
            label = ask("Label for the new key", required=False)
            if label is None:
                continue
            loading("Creating the key")
            try:
                created = call("createBucketAccessKey", {"bucketId": b["id"], "label": label or None})
            except AletError as e:
                error_screen("Could not create the key", e)
                continue
            created = created if isinstance(created, dict) else {}
            _show_secret(f"New key for {v(b, 'name')}", [
                ("Access key ID", v(created, "accessKeyId")),
                ("Secret key", v(created, "secretKey")),
                ("Endpoint", v(created, "endpoint", v(b, "endpoint"))),
                ("Region", v(created, "region", v(b, "region"))),
            ])
        else:
            k = keys[choice]
            if not danger_confirm(f"Revoke '{v(k, 'label', v(k, 'accessKeyId'))}'?",
                                  "Anything still using this key loses access to the bucket immediately."):
                continue
            act("Revoking the key", "The key has been revoked.",
                "deleteBucketAccessKey", {"bucketId": b["id"], "keyId": k["id"]})


def bucket_visibility(b: dict):
    current = str(v(b, "visibility", "PRIVATE"))
    choice = menu(f"{v(b, 'name')} — visibility",
                  ["Private — access keys only", "Public — anyone can read objects", "← Back"],
                  f"Currently: {current}")
    if choice is None or choice == 2:
        return
    target = "PRIVATE" if choice == 0 else "PUBLIC_READ"
    if target == current:
        return
    if target == "PUBLIC_READ":
        if not danger_confirm(f"Make '{v(b, 'name')}' publicly readable?",
                              "Every object in the bucket becomes readable by anyone on the internet."):
            return
    elif not confirm(f"Make '{v(b, 'name')}' private?"):
        return
    act("Updating visibility", f"{v(b, 'name')} is now {'public' if choice else 'private'}.",
        "setBucketVisibility", {"bucketId": b["id"], "visibility": target})


