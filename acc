def screen_uptime():
    data = load("uptime history", "getComponentHistory")
    if data is None:
        return
    components = data.get("components") if isinstance(data, dict) else data
    if not components:
        header("Uptime history", "Has this been flaky?")
        note = v(data, "note", "No history available.") if isinstance(data, dict) else "No history available."
        print(f"  {GREY}{note}{RESET}")
        pause()
        return

    span = max((c.get("history_days_available") or 0)
               for c in components if isinstance(c, dict))
    rows = []
    for c in components:
        if not isinstance(c, dict):
            continue
        uptime = num(c.get("uptime_percent") or c.get("uptime_percent_90d"))
        bad_days = c.get("days_with_incidents") or []
        pct = (f"{_state_color('OPERATIONAL' if not bad_days else 'DEGRADED')}{uptime:>8.3f}%{RESET}"
               if uptime is not None else f"{GREY}{'—':>9}{RESET}")
        rows.append(f"  {dot(v(c, 'current_state', ''))}  {trunc(v(c, 'name', v(c, 'id')), 26):<26} {pct}   "
                    f"{GREY}{len(bad_days)} bad day{'' if len(bad_days) == 1 else 's'}{RESET}")
        for day in bad_days:
            if not isinstance(day, dict):
                continue
            down = day.get("down_samples") or 0
            degraded = day.get("degraded_samples") or 0
            parts = ([f"{down} down"] if down else []) + ([f"{degraded} degraded"] if degraded else [])
            detail = ", ".join(parts) or "brief blip"
            rows.append(f"        {GREY}{fmt_dt(day.get('date'), 10)}   {detail}{RESET}")

    footer = None
    if isinstance(data, dict) and data.get("status_page_url"):
        footer = [f"  {GREY}Full status page: {RESET}{LIME}{data['status_page_url']}{RESET}"]
    show_rows("Uptime history",
              f"Last {span} days" if span else "Has this been flaky?",
              rows, footer=footer, unit="lines")


