def app_env(a: dict):
    while True:
        data = load(f"environment for {v(a, 'appName')}", "getAppEnv", {"appId": a["id"]})
        if data is None:
            return
        env = data.get("envVars") if isinstance(data, dict) and "envVars" in data else data
        env = env if isinstance(env, dict) else {}

        rows = [f"{k:<28} {GREY}{trunc(val, 34)}{RESET}" for k, val in sorted(env.items())]
        choice = menu(f"{v(a, 'appName')} — environment",
                      rows + ["＋  Add or change a variable", "✕  Remove a variable", "← Back"],
                      f"{len(env)} variable(s). Changes redeploy on the next build.")
        if choice is None or choice == len(rows) + 2:
            return

        if choice < len(rows):
            key = sorted(env)[choice]
            header(v(a, "appName"), f"Environment variable — {key}")
            print(f"  {GREY}Value:{RESET}\n\n  {LIME}{env[key]}{RESET}")
            pause()
            continue

        if choice == len(rows):  # add / change
            key = ask("Variable name")
            if not key:
                continue
            val = ask("Value", required=False)
            if val is None:
                continue
            merged = dict(env)
            merged[key] = val
            if not confirm(f"Set {key} on '{v(a, 'appName')}'?"):
                continue
            act("Updating environment", f"{key} saved.",
                "setAppEnv", {"appId": a["id"], "envVars": merged})
        else:  # remove
            if not env:
                continue
            key = pick_from(sorted(env), lambda k: k, "Remove which variable?")
            if not key:
                continue
            merged = {k: val for k, val in env.items() if k != key}
            if not danger_confirm(f"Remove {key}?", "The app loses this value on its next start."):
                continue
            act("Updating environment", f"{key} removed.",
                "setAppEnv", {"appId": a["id"], "envVars": merged})


