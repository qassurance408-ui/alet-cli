def screen_usage():
    rows = load("this month's usage", "getUsage")
    if rows is None:
        return
    if isinstance(rows, dict):
        rows = rows.get("content") or rows.get("usage") or []

    # The API returns one row per billing interval — thousands of them.
    # Roll them up per resource so the screen answers "what am I paying for?".
    totals: dict[tuple, dict] = {}
    for r in rows:
        if not isinstance(r, dict):
            continue
        key = (v(r, "resourceType", "OTHER"), v(r, "vmName", "unnamed"))
        agg = totals.setdefault(key, {"cost": 0.0, "minutes": 0, "plan": v(r, "planName", "")})
        agg["cost"] += float(r.get("billedCost") or 0)
        agg["minutes"] += int(r.get("billedMinutes") or 0)

    if not totals:
        header("Usage this month", "")
        print(f"  {GREY}No usage recorded this month.{RESET}")
        pause()
        return

    ordered = sorted(totals.items(), key=lambda item: -item[1]["cost"])
    grand = sum(agg["cost"] for _, agg in ordered)
    lines = [
        f"  {trunc(name, 27):<28} {GREY}{trunc(rtype, 9):<10} {trunc(agg['plan'], 8):<9}{RESET} "
        f"{agg['minutes'] / 60:>8,.1f} {fmt_etb(agg['cost']):>14}"
        for (rtype, name), agg in ordered
    ]
    show_rows(
        "Usage this month",
        f"{len(rows):,} billing intervals rolled up",
        lines,
        column_head=f"  {GREY}{'RESOURCE':<28} {'TYPE':<10} {'PLAN':<9} {'HOURS':>8} {'COST':>14}{RESET}",
        footer=[f"  {GREY}{'─' * 62}{RESET}",
                f"  {BOLD_WHITE}{'Total so far this month':<48}{RESET}"
                f"{BOLD_GREEN}{fmt_etb(grand):>14}{RESET}"],
        unit="resources")


def screen_transactions():
    page = 0
    while True:
        data = load("your transactions", "getTransactions", {"page": page, "size": 20})
        if data is None:
            return
        items = data.get("content", []) if isinstance(data, dict) else (data or [])
        total_pages = data.get("totalPages", 1) if isinstance(data, dict) else 1
        total = data.get("totalElements", len(items)) if isinstance(data, dict) else len(items)

        header("Transactions", f"{total:,} entries — page {page + 1} of {max(total_pages, 1)}")
        if not items:
            print(f"  {GREY}No transactions on this page.{RESET}")
        for t in items:
            amount = float(t.get("amount") or 0)
            color = RED if amount < 0 else GREEN
            print(f"  {GREY}{fmt_dt(t.get('createdAt'), 16)}{RESET}  "
                  f"{color}{amount:>12,.4f}{RESET}  "
                  f"{GREY}{trunc(v(t, 'description', v(t, 'type', '')), 46)}{RESET}")
        print(f"\n  {GREY}n  next page   p  previous page   q  back{RESET}")
        key = getch()
        if key in ("q", "\x1b\x1b", "\x03"):
            return
        if key in ("n", "\x1b[B", "j") and page < total_pages - 1:
            page += 1
        elif key in ("p", "\x1b[A", "k") and page > 0:
            page -= 1


