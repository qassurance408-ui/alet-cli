def bucket_link(b: dict):
    header(v(b, "name"), "Temporary link to one object")
    print(f"  {GREY}Creates a link that works without any credentials, then expires.{RESET}\n")
    key = ask("Object key (e.g. uploads/photo.jpg)")
    if not key:
        return
    direction = menu("What is the link for?",
                     ["Downloading the object", "Uploading to that key", "← Back"])
    if direction is None or direction == 2:
        return
    hours = ask_int("Valid for how many hours?", 1) or 1
    loading("Creating the link")
    try:
        data = call("presignUrl", {"bucketId": b["id"], "objectKey": key,
                                   "method": "GET" if direction == 0 else "PUT",
                                   "expirySeconds": hours * 3600})
    except AletError as e:
        error_screen("Could not create the link", e)
        return
    url = data.get("url") if isinstance(data, dict) else data
    header(v(b, "name"), f"Temporary link — {key}")
    print(f"  {GREY}Valid for {hours} hour(s). Anyone with this link can use it.{RESET}\n")
    print(f"  {LIME}{url}{RESET}")
    pause()


def bucket_connect(b: dict):
    apps = load("apps", "listApps")
    if apps is None:
        return
    if not apps:
        clear_screen()
        print(f"\n  {GREY}You don't have any apps to connect this bucket to.{RESET}")
        pause()
        return
    app = pick_from(apps, app_label, f"Connect {v(b, 'name')} to which app?",
                    "A dedicated key is minted for that app")
    if not app:
        return
    if not confirm(f"Wire '{v(b, 'name')}' into '{v(app, 'appName')}'?"):
        return
    loading("Creating the connection")
    try:
        data = call("connectBucketToApp", {"bucketId": b["id"], "appId": app["id"]})
    except AletError as e:
        error_screen("Could not connect the bucket", e)
        return
    env = (data.get("envVars") if isinstance(data, dict) else None) or (data if isinstance(data, dict) else {})
    header(f"{v(b, 'name')} → {v(app, 'appName')}", "Add these to the app's environment")
    print(f"  {YELLOW}The secret is shown once.{RESET}\n")
    for k, val in env.items():
        if not isinstance(val, (dict, list)):
            kv(k, f"{LIME}{val}{RESET}", 26)
    pause()


