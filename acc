# ── Screen scaffolding ────────────────────────────────────────────────────────
def load(what: str, tool: str, arguments: dict | None = None):
    """Fetch for display. Returns None (after showing the problem) on failure."""
    loading(f"Fetching {what}")
    try:
        return call(tool, arguments)
    except AletError as e:
        error_screen(f"Could not fetch {what}", e)
        return None


def refreshed(record: dict, tool: str, id_field: str) -> dict:
    """Re-read one record before showing its detail screen.

    List payloads carry every field, but they age while the user sits in the
    action menu. If the re-read fails we simply show what we already had.
    """
    loading("Refreshing")
    try:
        fresh = call(tool, {id_field: record["id"]})
    except (AletError, KeyError):
        return record
    return fresh if isinstance(fresh, dict) and fresh.get("id") else record


def act(doing: str, done: str, tool: str, arguments: dict | None = None):
    """Run a mutation with a spinner and a plain-language result. Returns data or False."""
    loading(doing)
    try:
        result = call(tool, arguments)
    except AletError as e:
        clear_screen()
        fail(f"{doing} failed.")
        print(f"\n  {GREY}{e}{RESET}")
        pause()
        return False
    clear_screen()
    ok(done)
    pause()
    return result if result is not None else True


def browse(title: str, subtitle: str, fetch, label_fn, open_fn,
           create_label: str | None = None, create_fn=None,
           empty: str = "Nothing here yet."):
    """The list → pick → act loop every section shares."""
    while True:
        items = fetch()
        if items is None:
            return
        if not isinstance(items, list):
            items = [items]

        labels = [label_fn(i) for i in items]
        tail = ([create_label] if create_fn else []) + ["← Back"]
        note = subtitle if items else f"{empty}"

        choice = menu(title, labels + tail, note)
        if choice is None or choice == len(labels) + len(tail) - 1:
            return
        if create_fn and choice == len(labels):
            create_fn()
            continue
        open_fn(items[choice])


def actions(title: str, subtitle: str, options: list[tuple[str, object]]):
    """Contextual action menu. `options` is [(label, handler-or-None)].

    A handler returning "back" closes the menu (used after start/stop/delete,
    where the resource we are holding is now stale).
    """
    labels = [label for label, _ in options] + ["← Back"]
    while True:
        choice = menu(title, labels, subtitle)
        if choice is None or choice == len(labels) - 1:
            return
        handler = options[choice][1]
        if handler and handler() == "back":
            return


def pick_plan(what: str, tool: str, label_fn, arguments: dict | None = None):
    plans = load(f"{what} plans", tool, arguments)
    if not plans:
        return None
    return pick_from(plans, label_fn, f"Choose a {what} plan", "Prices are per month")


