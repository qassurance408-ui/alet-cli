def bucket_label(b: dict) -> str:
    used, quota = b.get("usedBytes") or 0, b.get("quotaBytes") or 0
    pct = f"{(used / quota * 100):.0f}%" if quota else "—"
    vis = "public" if str(v(b, "visibility", "")).startswith("PUBLIC") else "private"
    return (f"{trunc(v(b, 'name'), 24):<24} {status_cell(v(b, 'status', '?'))} "
            f"{GREY}{v(b, 'planName', ''):<6} {pct:>4} used  {vis}{RESET}")


def print_bucket_detail(b: dict):
    b = refreshed(b, "getBucket", "bucketId")
    used, quota = b.get("usedBytes") or 0, b.get("quotaBytes") or 0
    header(v(b, "name"), f"Object storage   {paint(v(b, 'status', '?'))}")
    kv("Tier", f"{v(b, 'planName')}  ({fmt_etb(b.get('pricePerMonth'))}/mo)")
    if quota:
        kv("Used", f"{bar(used / quota)}  {fmt_bytes(used)} of {fmt_bytes(quota)}")
