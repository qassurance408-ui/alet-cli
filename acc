# ── Entry point ───────────────────────────────────────────────────────────────
SHORTCUTS = {
    "vms": screen_vms, "apps": screen_apps, "dbs": screen_databases,
    "storage": screen_storage, "domains": screen_domains, "projects": screen_projects,
    "vpn": screen_vpn, "billing": screen_billing, "balance": screen_balance,
    "usage": screen_usage, "status": screen_platform,
}

HELP = f"""\
{BOLD}acc{RESET} — AletCloud CLI  {GREY}v{VERSION}{RESET}

Usage:
  acc                Launch the interactive menu
  acc vms            Virtual machines
  acc apps           Hosted apps
  acc dbs            Managed databases
  acc storage        Object storage buckets and keys
  acc domains        Domains and DNS records
  acc projects       Hosting projects
  acc vpn            VPN access and devices
  acc billing        Balance, usage and transactions
  acc balance        Wallet balance only
  acc usage          This month's usage only
  acc status         Platform health, incidents, maintenance
  acc help           Show this message
  acc version        Show the version

Authentication:
  Reads ALET_PAT from the environment, {GREY}~/.config/aletcloud/config{RESET},
  or {GREY}~/.aletcloudrc{RESET}. If none is set, acc asks for a token on first run.
"""


def main():
    global PAT
    _enable_ansi()
    args = sys.argv[1:]

    if args and args[0] in ("help", "--help", "-h"):
        print(HELP)
        return 0
    if args and args[0] in ("version", "--version", "-v"):
        print(f"acc {VERSION}")
        return 0
    if args and args[0] not in SHORTCUTS:
        print(f"{RED}[Error]{RESET} Unknown command '{args[0]}'. Run 'acc help'.", file=sys.stderr)
        return 1

    PAT = _load_pat() or _prompt_for_pat()

    loading("Connecting to AletCloud")
    try:
        connect()
    except AletError as e:
        print(f"\n  {RED}✗  Could not connect.{RESET}\n\n  {GREY}{e}{RESET}\n", file=sys.stderr)
        return 1

    enter_ui()
    try:
        if args:
            SHORTCUTS[args[0]]()
        else:
            main_menu()
    except KeyboardInterrupt:
        pass
    finally:
        exit_ui()
    print(f"  {GREY}Goodbye.{RESET}\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
