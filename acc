#!/usr/bin/env python3
import os
import sys
import json
import http.client
import ssl

WINDOWS = os.name == "nt"
if WINDOWS:
    import msvcrt
else:
    import tty
    import termios

VERSION = "0.5"

# ── Auth ──────────────────────────────────────────────────────────────────────
CONFIG_FILE = os.path.expanduser("~/.config/aletcloud/config")

def _load_pat() -> str | None:
    """Resolve PAT from (in priority order):
    1. ALET_PAT environment variable
    2. ~/.config/aletcloud/config  (key=value format, line: ALET_PAT=<token>)
    3. ~/.aletcloudrc              (same key=value format)
    """
    pat = os.environ.get("ALET_PAT")
    if pat:
        return pat.strip()

    for path in (CONFIG_FILE, os.path.expanduser("~/.aletcloudrc")):
        try:
            with open(path) as f:
                for line in f:
                    line = line.strip()
                    if line.startswith("#") or "=" not in line:
                        continue
                    key, _, val = line.partition("=")
                    if key.strip() == "ALET_PAT" and val.strip():
                        return val.strip()
        except FileNotFoundError:
            continue

    return None


def _validate_pat(token: str) -> tuple[bool, str]:
    """Check a token by actually using it. Returns (accepted, reason).

    The `initialize` handshake is NOT authenticated — it answers 200 and hands
    out a session for any string at all — so checking its status proves nothing.
    Only a real tool call exercises the token, and a bad one comes back as a
    401 envelope inside an otherwise successful response.
    """
    global PAT
    saved = PAT
    PAT = token
    try:
        session = _open_session()
        body, _ = _rpc({"jsonrpc": "2.0", "id": 1, "method": "tools/call",
                        "params": {"name": "getBalance", "arguments": {}}},
                       session_id=session)
        _unwrap(body)
        return True, ""
    except AletError as e:
        reason = str(e)
        # Tell "the server said no" apart from "we never reached the server".
        if reason.startswith("Could not reach AletCloud"):
            return False, reason
        return False, reason or "The server rejected that token."
    finally:
        PAT = saved


def _save_pat(token: str) -> None:
    """Write ALET_PAT to the config file, creating it if needed."""
    os.makedirs(os.path.dirname(CONFIG_FILE), exist_ok=True)

    existing = []
    try:
        with open(CONFIG_FILE) as f:
            existing = f.readlines()
    except FileNotFoundError:
        pass

    lines = [l for l in existing if not l.strip().startswith("ALET_PAT")]
    lines.append(f"ALET_PAT={token}\n")

    with open(CONFIG_FILE, "w") as f:
        f.writelines(lines)

    if not WINDOWS:
        os.chmod(CONFIG_FILE, 0o600)  # owner read/write only — token is a secret
    # On Windows chmod only toggles the read-only bit, so it would not actually
    # restrict anyone; the file inherits the profile directory's ACL instead.


def _prompt_for_pat() -> str:
    """Interactive first-run setup. Loops until the user provides a valid PAT."""
    B, G, Y, R, D, X = "\033[1m", "\033[38;5;83m", "\033[38;5;214m", "\033[38;5;196m", "\033[2m", "\033[0m"

    print(f"\n{B}Welcome to AletCloud CLI!{X}")
    print("No personal access token found. You need one to continue.")
    print(f"{D}Generate a token at: {X}{Y}https://aletcloud.com/access-tokens{X}\n")

    while True:
        try:
            token = input(f"{B}Paste your PAT: {X}").strip()
        except (KeyboardInterrupt, EOFError):
            print("\nAborted.")
            sys.exit(0)

        if not token:
            print(f"{R}Token cannot be empty. Try again.{X}")
            continue
        if not token.startswith("alet_pat_"):
            print(f"{R}That doesn't look like a valid token (expected it to start with alet_pat_).{X}")
            continue

        print("  Checking it against the platform… ", end="", flush=True)
        accepted, reason = _validate_pat(token)
        if accepted:
            print(f"{G}✓ Works!{X}")
            _save_pat(token)
            print(f"  Token saved to {D}{CONFIG_FILE}{X}")
            print("  You won't be asked again.\n")
            return token
        print(f"{R}✗{X}")
        print(f"  {reason}")
        print(f"  {D}Nothing was saved. Check the token and try again.{X}")


MCP_HOST = "mcp.aletcloud.com"
MCP_PATH = "/mcp"

# ── Colors (AletCloud palette) ────────────────────────────────────────────────
BOLD        = "\033[1m"
BOLD_WHITE  = "\033[1;37m"
BOLD_GREEN  = "\033[1;38;5;83m"   # vivid green — selected rows, headings, logo
GREEN       = "\033[38;5;83m"     # vivid green — RUNNING / LIVE / ACTIVE
YELLOW      = "\033[38;5;214m"    # amber-orange — STOPPED / transitional
RED         = "\033[38;5;196m"    # bright red — errors
LIME        = "\033[38;5;83m"     # URLs / connection strings
DIM         = "\033[2m"
GREY        = "\033[38;5;245m"    # muted grey — secondary text, nav hints
RESET       = "\033[0m"
HIDE_CURSOR = "\033[?25l"
SHOW_CURSOR = "\033[?25h"

# ── MCP transport (private — no screen below this line knows it exists) ───────
PAT: str | None = None
_session_id: str | None = None
_next_id = 1


class AletError(Exception):
    """Anything the control plane refused or could not answer."""


def _rpc(payload: dict, session_id: str | None = None) -> tuple[dict, str | None]:
    headers = {
        "Authorization": f"Bearer {PAT}",
        "Content-Type": "application/json",
        "Accept": "application/json, text/event-stream",
        "Host": MCP_HOST,
    }
    if session_id:
        headers["mcp-session-id"] = session_id

    ctx = ssl.create_default_context()
    conn = http.client.HTTPSConnection(MCP_HOST, context=ctx, timeout=60)
    try:
        conn.request("POST", MCP_PATH, body=json.dumps(payload).encode(), headers=headers)
        resp = conn.getresponse()
        returned_session = resp.getheader("mcp-session-id")

        raw_bytes = bytearray()
        while True:
            try:
                chunk = resp.read(8192)
                if not chunk:
                    break
                raw_bytes.extend(chunk)
            except http.client.IncompleteRead as e:
                raw_bytes.extend(e.partial)
                break

        raw = raw_bytes.decode("utf-8", errors="replace")

        # Responses arrive either as plain JSON or as an SSE `data:` stream.
        body = None
        for line in raw.splitlines():
            line = line.strip()
            if line.startswith("data:"):
                candidate = line[len("data:"):].strip()
                if candidate:
                    try:
                        body = json.loads(candidate)
                    except json.JSONDecodeError:
                        pass
        if body is None:
            try:
                body = json.loads(raw.strip())
            except json.JSONDecodeError:
                raise AletError(f"Unreadable reply from the server (HTTP {resp.status}).")

        return body, returned_session
    except AletError:
        raise
    except Exception as e:
        raise AletError(f"Could not reach AletCloud: {e}")
    finally:
        conn.close()


def _open_session() -> str:
    global _next_id
    _next_id += 1
    payload = {
        "jsonrpc": "2.0", "id": _next_id, "method": "initialize",
        "params": {
            "protocolVersion": "2024-11-05", "capabilities": {},
            "clientInfo": {"name": "acc", "version": VERSION},
        },
    }
    _, session_id = _rpc(payload)
    if not session_id:
        raise AletError("The server did not open a session.")
    return session_id


def connect() -> None:
    global _session_id
    _session_id = _open_session()


def _unwrap(body: dict):
    """Turn a JSON-RPC reply into plain Python data, or raise AletError."""
    if "error" in body:
        raise AletError((body["error"] or {}).get("message") or "The request was rejected.")

    result = body.get("result") or {}
    content = result.get("content") or []
    text = ""
    for block in content:
        if isinstance(block, dict) and block.get("type", "text") == "text":
            text += block.get("text") or ""

    if result.get("isError"):
        raise AletError(text.strip() or "The request was rejected.")

    text = text.strip()
    if not text:
        return None  # e.g. password change: success, no body
    try:
        data = json.loads(text)
    except json.JSONDecodeError:
        return text  # a plain-language answer is still an answer

    # The control plane reports application errors as an ordinary payload
    # ({"error": true, "status": 404, "message": {...}}) rather than with the
    # protocol's error flag — so catch it here, or screens render a 404 as data.
    if isinstance(data, dict) and data.get("error") is True:
        raise AletError(_describe_error(data))
    return data


def _describe_error(payload: dict) -> str:
    """Turn the server's error envelope into one plain sentence."""
    status = payload.get("status")
    body = payload.get("message")

    if isinstance(body, dict):
        detail = body.get("message") or body.get("error")
        fields = body.get("errors")
        if isinstance(fields, dict) and fields:
            detail = "; ".join(f"{k}: {val}" for k, val in fields.items())
    else:
        detail = body

    detail = str(detail).strip() if detail else ""
    if not detail:
        detail = {401: "Your access token was not accepted.",
                  403: "Your token is not allowed to do that.",
                  404: "That resource no longer exists.",
                  409: "That conflicts with something already there.",
                  429: "Too many requests — try again shortly."}.get(status, "The request was rejected.")
    return f"{detail}" if status is None else f"{detail}  (error {status})"


def call(tool: str, arguments: dict | None = None):
    """Invoke one control-plane operation. Raises AletError on failure."""
    global _next_id, _session_id
    if _session_id is None:
        connect()

    for attempt in (1, 2):
        _next_id += 1
        payload = {
            "jsonrpc": "2.0", "id": _next_id, "method": "tools/call",
            "params": {"name": tool, "arguments": _clean(arguments or {})},
        }
        body, _ = _rpc(payload, session_id=_session_id)
        if "error" in body and attempt == 1:
            msg = ((body.get("error") or {}).get("message") or "").lower()
            if "session" in msg:  # session aged out — reopen once and retry
                connect()
                continue
        return _unwrap(body)


def _clean(args: dict) -> dict:
    """Drop unset optional arguments so the server applies its own defaults."""
    return {k: v for k, v in args.items() if v is not None and v != ""}


# ── Terminal / menu utils ─────────────────────────────────────────────────────
# Windows delivers arrows as a two-byte prefixed pair instead of an ANSI escape
# sequence. Translate them so every caller can keep comparing against the one
# vocabulary ("\x1b[A", "\x1b[B", ...) regardless of platform.
_WIN_KEYS = {"H": "\x1b[A", "P": "\x1b[B", "K": "\x1b[D", "M": "\x1b[C"}


def getch() -> str:
    _painter.show()          # nothing is on screen until the frame is painted
    if WINDOWS:
        ch = msvcrt.getwch()
        if ch in ("\x00", "\xe0"):          # arrow / function key prefix
            return _WIN_KEYS.get(msvcrt.getwch(), "")
        if ch == "\x1b":                     # bare Esc — Windows sends no tail
            return "\x1b\x1b"
        return ch

    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        ch = sys.stdin.read(1)
        if ch == "\x1b":
            return ch + sys.stdin.read(1) + sys.stdin.read(1)
        return ch
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)


def _enable_ansi() -> None:
    """Turn on virtual-terminal processing so the colour codes render as colour
    rather than as literal escape bytes. Windows Terminal does this already;
    the old conhost window does not."""
    if not WINDOWS:
        return
    for stream in (sys.stdout, sys.stderr):
        try:
            stream.reconfigure(encoding="utf-8")   # box-drawing glyphs, ✓ and ✗
        except Exception:
            pass
    try:
        import ctypes
        kernel32 = ctypes.windll.kernel32
        for handle in (-11, -12):             # stdout, stderr
            mode = ctypes.c_uint32()
            h = kernel32.GetStdHandle(handle)
            if kernel32.GetConsoleMode(h, ctypes.byref(mode)):
                kernel32.SetConsoleMode(h, mode.value | 0x0004)
    except Exception:
        pass                                  # plain text is still readable


ALT_ON = "\033[?1049h"
ALT_OFF = "\033[?1049l"


class _Painter:
    """A stdout stand-in that paints a whole screen in one write.

    The screens here are built with ordinary `print` calls, which is easy to
    read but means a redraw arrives as dozens of separate writes. Unix
    terminals coalesce those into one render pass; Windows consoles repaint per
    write, so you watch the frame get erased and then painted back in line by
    line — the flicker.

    So: buffer everything a screen prints, and emit it as a single string that
    homes the cursor and overwrites the previous frame in place. No erase-first
    step, no gap. `\033[K` on each line clears whatever the old frame left
    beyond the new line's end, and a trailing `\033[J` drops any rows the new
    frame doesn't reach.
    """

    def __init__(self, real):
        self._real = real
        self._buf = None          # None → pass straight through, list → buffering

    def __getattr__(self, name):
        return getattr(self._real, name)

    def write(self, text: str) -> int:
        if self._buf is None:
            return self._real.write(text)
        self._buf.append(text)
        return len(text)

    def flush(self) -> None:
        if self._buf is None:
            self._real.flush()

    def raw_write(self, text: str) -> None:
        """Emit immediately, bypassing the frame buffer (cursor/screen control)."""
        self._real.write(text)
        self._real.flush()

    def begin(self) -> None:
        """Start a new frame. The old one stays on screen until this one paints."""
        self._buf = []

    def show(self) -> None:
        """Paint the frame so far. Safe to call repeatedly — it repaints from
        the top each time, so a screen can grow (a spinner line, a prompt)
        without a full redraw."""
        if self._buf is None:
            return
        lines = "".join(self._buf).split("\n")
        self._real.write("\033[H" + "\033[K\n".join(lines) + "\033[J")
        self._real.flush()

    def detach(self) -> None:
        """Go back to plain pass-through output."""
        self._buf = None


_painter = _Painter(sys.stdout)
sys.stdout = _painter
_alt_screen = False


def enter_ui() -> None:
    """Switch to the alternate screen buffer so the full-screen UI never
    disturbs the scrollback the user had before running acc."""
    global _alt_screen
    _painter.raw_write(ALT_ON + "\033[H" + HIDE_CURSOR)
    _alt_screen = True


def exit_ui() -> None:
    """Undo enter_ui and stop buffering. Idempotent — every exit path calls it."""
    global _alt_screen
    _painter.detach()
    if _alt_screen:
        _painter.raw_write(ALT_OFF)
        _alt_screen = False
    _painter.raw_write(SHOW_CURSOR)


def clear_screen():
    _painter.begin()


def header(title: str, subtitle: str = "", preamble: list[str] | None = None):
    clear_screen()
    print(f"\n  {BOLD_GREEN}alet{RESET} {GREY}—{RESET} {BOLD_WHITE}{title}{RESET}")
    if subtitle:
        print(f"  {GREY}{subtitle}{RESET}")
    print(f"  {GREY}{'─' * 62}{RESET}\n")
    if preamble:
        for line in preamble:
            print(line)
        print()


def menu(title: str, items: list[str], subtitle: str = "",
         preamble: list[str] | None = None) -> int | None:
    """Arrow-key menu. Returns the chosen index, or None on q/Esc.

    `preamble` renders above the options and survives every redraw — use it for
    context the user needs while choosing (a status panel, a warning).
    """
    if not items:
        return None
    idx = 0
    _painter.raw_write(HIDE_CURSOR)
    while True:
        header(title, subtitle, preamble)
        for i, item in enumerate(items):
            if i == idx:
                print(f"  {BOLD_GREEN}▶  {item}{RESET}")
            else:
                print(f"  {GREY}    {item}{RESET}")

        print(f"\n  {GREY}↑/↓  navigate   enter  select   q  back{RESET}")

        key = getch()
        if key in ("\x1b[A", "k"):
            idx = (idx - 1) % len(items)
        elif key in ("\x1b[B", "j"):
            idx = (idx + 1) % len(items)
        elif key in ("\r", "\n"):
            return idx
        elif key in ("q", "\x1b\x1b", "\x03"):
            return None


def pick_from(items: list, label_fn, title: str, subtitle: str = ""):
    choice = menu(title, [label_fn(i) for i in items], subtitle)
    return items[choice] if choice is not None else None


def pause(msg: str = "Press any key to continue..."):
    print(f"\n  {GREY}{msg}{RESET}", flush=True)
    getch()


def loading(msg: str):
    print(f"\n  {GREY}⟳  {msg}...{RESET}")
    _painter.show()          # the wait is the point — show it now


def confirm(msg: str) -> bool:
    return menu(f"Confirm: {msg}", ["Yes, proceed", "No, cancel"]) == 0


def danger_confirm(msg: str, consequence: str) -> bool:
    """Confirmation that spells out what is irreversible before asking."""
    return menu(f"Confirm: {msg}",
                ["No, cancel", "Yes — I understand, do it"],
                f"⚠  {consequence}") == 1


def ask(prompt: str, default: str | None = None, required: bool = True) -> str | None:
    """Free-text prompt. Returns None if the user backs out with an empty line."""
    hint = f" {GREY}[{default}]{RESET}" if default else ""
    while True:
        print(f"  {BOLD}{prompt}{RESET}{hint}{GREY}:{RESET} ", end="")
        _painter.show()
        _painter.raw_write(SHOW_CURSOR)
        try:
            val = input().strip()
        except (KeyboardInterrupt, EOFError):
            print()
            return None
        if not val and default is not None:
            return default
        if not val:
            if not required:
                return ""
            print(f"  {GREY}(empty — press Ctrl-C to go back){RESET}")
            continue
        return val


def ask_int(prompt: str, default: int | None = None, required: bool = True) -> int | None:
    while True:
        raw = ask(prompt, str(default) if default is not None else None, required)
        if raw is None:
            return None
        if raw == "":
            return None
        try:
            return int(raw)
        except ValueError:
            print(f"  {RED}Please enter a whole number.{RESET}")


def ask_yes_no(prompt: str) -> bool:
    return menu(prompt, ["Yes", "No"]) == 0


def ok(msg: str):
    print(f"\n  {GREEN}✓{RESET}  {msg}")


def fail(msg: str):
    print(f"\n  {RED}✗{RESET}  {msg}")


def error_screen(what: str, err: Exception):
    clear_screen()
    print(f"\n  {RED}✗  {what}{RESET}\n")
    print(f"  {GREY}{err}{RESET}")
    pause()


# ── Formatters ────────────────────────────────────────────────────────────────
def v(d: dict, key: str, default: str = "—"):
    """Null-safe field read — the API sends JSON null for 'unset', not a missing key."""
    val = d.get(key)
    if val is None or val == "":
        return default
    return val


def num(x):
    """Coerce to float, or None. Some endpoints send numbers as strings."""
    if isinstance(x, bool) or x is None or x == "":
        return None
    try:
        return float(x)
    except (TypeError, ValueError):
        return None


def _state_color(state: str) -> str:
    u = str(state).upper()
    if u in ("RUNNING", "LIVE", "ACTIVE", "OPERATIONAL", "AVAILABLE", "SUCCEEDED"):
        return GREEN
    if u in ("STOPPED", "BUILDING", "PROVISIONING", "PENDING", "DEPLOYING",
             "DEGRADED", "DELETING", "MAINTENANCE", "RESTARTING"):
        return YELLOW
    if u in ("ERROR", "FAILED", "DOWN", "OUTAGE", "SUSPENDED", "EXPIRED"):
        return RED
    return GREY


def paint(state: str) -> str:
    """One status palette for every resource on the platform."""
    u = str(state).upper()
    return f"{_state_color(u)}{u}{RESET}"


def status_cell(state: str, width: int = 12) -> str:
    """Padded status for table columns — pads inside the colour codes, so the
    invisible escape bytes never count toward the column width."""
    u = str(state).upper()
    return f"{_state_color(u)}{u:<{width}}{RESET}"


def dot(state: str) -> str:
    u = str(state).upper()
    if u in ("RUNNING", "LIVE", "ACTIVE", "OPERATIONAL"):
        return f"{GREEN}●{RESET}"
    if u in ("ERROR", "FAILED", "DOWN", "OUTAGE"):
        return f"{RED}●{RESET}"
    if u in ("STOPPED", "BUILDING", "PROVISIONING", "PENDING", "DEGRADED", "DELETING"):
        return f"{YELLOW}●{RESET}"
    return f"{GREY}●{RESET}"


def _engine_icon(engine: str) -> str:
    return {"MYSQL": "🐬", "POSTGRESQL": "🐘", "MONGODB": "🍃"}.get(str(engine).upper(), "🗄")


def fmt_etb(n) -> str:
    try:
        return f"ETB {float(n):,.2f}"
    except (TypeError, ValueError):
        return "—"


def fmt_mb(mb) -> str:
    try:
        mb = int(mb)
    except (TypeError, ValueError):
        return "—"
    return f"{mb // 1024} GB" if mb >= 1024 else f"{mb} MB"


def fmt_bytes(n) -> str:
    try:
        n = float(n)
    except (TypeError, ValueError):
        return "—"
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024 or unit == "TB":
            return f"{n:,.1f} {unit}" if unit != "B" else f"{int(n)} B"
        n /= 1024
    return f"{n:,.1f} TB"


def fmt_dt(s, width: int = 19) -> str:
    if not s:
        return "—"
    return str(s)[:width].replace("T", " ")


def bar(fraction: float, width: int = 26) -> str:
    fraction = max(0.0, min(1.0, fraction))
    filled = int(round(fraction * width))
    color = GREEN if fraction < 0.75 else YELLOW if fraction < 0.9 else RED
    return f"{color}{'█' * filled}{RESET}{GREY}{'░' * (width - filled)}{RESET}"


def kv(label: str, value, width: int = 18):
    print(f"  {GREY}{label:<{width}}{RESET} {value}")


def trunc(s, n: int) -> str:
    s = str(s)
    return s if len(s) <= n else s[: n - 1] + "…"


def _page_size() -> int:
    """Rows of body text that fit, leaving room for the header and footer."""
    try:
        rows = os.get_terminal_size().lines
    except OSError:
        rows = 24
    return max(5, rows - 12)


def show_rows(title: str, subtitle: str, rows: list[str],
              column_head: str | None = None, footer: list[str] | None = None,
              empty: str = "Nothing to show.", unit: str = "rows"):
    """Pager for anything long enough to scroll off the top. Rows print verbatim."""
    if not rows:
        header(title, subtitle)
        print(f"  {GREY}{empty}{RESET}")
        pause()
        return

    size = _page_size() - (1 if column_head else 0) - len(footer or [])
    size = max(3, size)
    pages = max(1, (len(rows) + size - 1) // size)
    page = 0
    while True:
        note = f"{subtitle}   ({len(rows)} {unit}"
        note += f", page {page + 1}/{pages})" if pages > 1 else ")"
        header(title, note)
        if column_head:
            print(column_head)
        for line in rows[page * size:(page + 1) * size]:
            print(line)
        for line in (footer or []):
            print(line)
        nav = "n  next   p  previous   q  back" if pages > 1 else "q  back"
        print(f"\n  {GREY}{nav}{RESET}")
        key = getch()
        if key in ("q", "\x1b\x1b", "\x03", "\r", "\n"):
            return
        if key in ("n", "\x1b[B", "j") and page < pages - 1:
            page += 1
        elif key in ("p", "\x1b[A", "k") and page > 0:
            page -= 1


def show_lines(title: str, subtitle: str, lines: list[str], empty: str = "Nothing to show."):
    """Pager for log output and other long, flat text."""
    show_rows(title, subtitle, [f"  {GREY}{l}{RESET}" for l in lines],
