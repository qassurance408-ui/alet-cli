FRAMEWORK_HINTS = [
    ("Static site (plain HTML/CSS/JS)", "STATIC"),
    ("Node.js server",                  "NODEJS"),
    ("Angular",                         "ANGULAR"),
    ("Vite",                            "VITE"),
]


def ask_build_settings() -> dict | None:
    """Optional build overrides. Returns {} to let the platform auto-detect,
    or None if the user backed out."""
    choice = menu("Build settings",
                  ["Detect them for me (recommended)", "Set them myself"],
                  "AletCloud inspects the repository and picks these automatically")
    if choice is None:
        return None
    if choice == 0:
        return {}

    labels = [label for label, _ in FRAMEWORK_HINTS] + ["Something else — let me type it",
                                                        "Leave it to auto-detection"]
    pick = menu("Framework", labels, "What is this repository built with?")
    if pick is None:
        return None
    if pick < len(FRAMEWORK_HINTS):
        framework = FRAMEWORK_HINTS[pick][1]
    elif pick == len(FRAMEWORK_HINTS):
        header("Build settings", "Framework")
        print(f"  {GREY}Examples the platform recognises: STATIC, NODEJS, ANGULAR, VITE,{RESET}")
        print(f"  {GREY}SPRING_BOOT. If it isn't recognised the deploy is rejected with a{RESET}")
        print(f"  {GREY}message saying so — nothing is created.{RESET}\n")
        framework = ask("Framework", required=False) or None
        if framework:
            framework = framework.strip().upper()
    else:
        framework = None

    header("Build settings", "Leave anything blank to let AletCloud decide")
    build = ask("Build command", required=False)
    if build is None:
        return None
    output = ask("Publish directory (static builds)", required=False)
    if output is None:
        return None
    root = ask("Root directory (monorepos)", required=False)
    if root is None:
        return None
    port = ask_int("Port the app listens on", required=False)

    return {"framework": framework, "buildCommand": build or None,
            "outputDir": output or None, "rootDir": root or None,
            "containerPort": port}


